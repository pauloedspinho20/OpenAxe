# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.turbo

# Local-only test assets (third-party sample .nam/.wav files, not ours to redistribute)
public/dev-test/

# The built openaxe_core.{js,wasm} ARE committed (regenerate with
# scripts/build-core-wasm.sh when packages/core's DSP/ABI changes) because the
# Vercel production build can't run emscripten - production needs the artifact
# in-repo. packages/core/build/ itself stays ignored.
packages/core/build/

# VST3 build tree (repopulated on every build)
packages/vst3/build/
packages/vst3/build-tsan/

# Native desktop build tree (apps/desktop/CMakeLists.txt + FetchContent deps)
apps/desktop/build/

# CPack intermediate staging dir (repopulated on every `cpack` run)
apps/desktop/_CPack_Packages/

# Playwright e2e output
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Test coverage
coverage/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/.gitkeep
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*storybook.log
storybook-static

# Generated macOS iconset intermediate;
# only the .icns/.ico/.png artifacts are committed.
apps/desktop/packaging/openaxe.iconset

# Woodpecker local secrets (OAuth + agent secret — never commit)
woodpecker/.env

# Manual release staging (woodpecker-manual.sh)
dist-release/
