# Copy to .env and fill in. NEVER commit .env.
# Generate the agent secret with: openssl rand -hex 32

# Pinned server/agent version (binaries + images must match; tags carry a `v`).
WOODPECKER_VERSION=v3.18.1

# Local-only mode: no public hostname until the tunnel/domain lands (issue #427).
WOODPECKER_HOST=http://localhost:8000
WOODPECKER_OPEN=true
# Free webhook delivery without a domain (smee.io): activation REQUIRES a
# public webhook URL — GitHub rejects localhost. Uncomment after creating a
# channel at https://smee.io/new, then run a forwarder (see docs/ci-woodpecker.md).
# WOODPECKER_EXPERT_WEBHOOK_HOST=https://smee.io/<channel-id>

# GitHub OAuth app (callback http://localhost:8000/authorize in local-only mode).
WOODPECKER_GITHUB=true
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# Shared secret for all three agents (mac/linux/win).
WOODPECKER_AGENT_SECRET=

# Injected into every pipeline step (name:value, comma-separated). On this Mac
# the linux/amd64 container runs under Rosetta emulation, where the realtime
# seqlock stress test (vst3_monitor_tap) deadlocks — skip it there; native
# macOS and real x86 Linux run it normally (see scripts/ci-local.mjs).
WOODPECKER_ENVIRONMENT=OPENAXE_CI_SKIP_MONITOR_TAP:1

# Repo secrets below are entered in the Woodpecker UI per-repo
# (repo Settings → Secrets), NOT here:
#   r2_access_key, r2_secret_key, r2_account_id  (release upload legs)
#   pages_api_token                              (Pages deploy step)

R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ACCOUNT_ID=