# Copy to .env and fill in. NEVER commit .env.
# Generate the agent secret with: openssl rand -hex 32

# Pinned server/agent version (binaries + images must match; tags carry a `v`).
WOODPECKER_VERSION=v3.18.1

# Local-only mode: no public hostname until the tunnel/domain lands (issue #427).
WOODPECKER_HOST=http://localhost:8000
WOODPECKER_OPEN=true

# GitHub OAuth app (callback http://localhost:8000/authorize in local-only mode).
WOODPECKER_GITHUB=true
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# Shared secret for all three agents (mac/linux/win).
WOODPECKER_AGENT_SECRET=

# Repo secrets below are entered in the Woodpecker UI per-repo
# (repo Settings → Secrets), NOT here:
#   r2_access_key, r2_secret_key, r2_account_id  (release upload legs)
#   pages_api_token                              (Pages deploy step)
