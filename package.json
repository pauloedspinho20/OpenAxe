{
  "name": "openaxe",
  "private": true,
  "version": "0.2.2",
  "description": "OpenAxe — guitar/bass amp + cab + effects suite (web + desktop + VST3 plugin) built on Neural Amp Modeler",
  "repository": {
    "type": "git",
    "url": "https://github.com/pauloedspinho20/OpenAxe.git"
  },
  "homepage": "https://github.com/pauloedspinho20/OpenAxe#readme",
  "bugs": {
    "url": "https://github.com/pauloedspinho20/OpenAxe/issues"
  },
  "license": "GPL-3.0-only",
  "keywords": [
    "guitar",
    "amp-sim",
    "nam",
    "wasm",
    "dsp",
    "vst3",
    "audio",
    "gpl"
  ],
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "turbo run dev --filter=@openaxe/web",
    "dev:web": "turbo run dev --filter=@openaxe/web",
    "dev:desktop": "turbo run dev --filter=@openaxe/desktop",
    "dev:desktop:attach": "pnpm --filter @openaxe/desktop dev:attach",
    "dev:all": "turbo run dev",
    "build": "turbo run build --filter=!@openaxe/desktop",
    "build:web": "turbo run build --filter=@openaxe/web",
    "build:desktop": "turbo run build --filter=@openaxe/desktop",
    "build:all": "turbo run build",
    "package:desktop": "pnpm --filter @openaxe/desktop package",
    "lint": "turbo run lint",
    "check:grid": "node scripts/check-grid-dims.mjs",
    "format": "prettier --write .",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "test:e2e": "turbo run test:e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.10.10",
    "typescript": "~6.0.2",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "storybook": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@chromatic-com/storybook": "5.3.0",
    "@storybook/addon-mcp": "^0.7.0"
  },
  "pnpm": {
    "overrides": {
      "valibot": "^1.4.0"
    }
  }
}
