{
  "name": "nam-web-studio",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "turbo run dev --filter=@nam/web",
    "dev:web": "turbo run dev --filter=@nam/web",
    "dev:desktop": "turbo run dev --filter=@nam/desktop",
    "dev:desktop:attach": "pnpm --filter @nam/desktop dev:attach",
    "dev:all": "turbo run dev",
    "build": "turbo run build --filter=!@nam/desktop",
    "build:web": "turbo run build --filter=@nam/web",
    "build:desktop": "turbo run build --filter=@nam/desktop",
    "build:all": "turbo run build",
    "package:desktop": "pnpm --filter @nam/desktop package",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "test:e2e": "turbo run test:e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.10.10",
    "typescript": "~6.0.2",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "storybook": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-mcp": "^0.7.0"
  }
}
