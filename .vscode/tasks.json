{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "pnpm install",
      "detail": "pnpm install across the workspace (apps/web, packages/ui)",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Install Playwright browsers",
      "type": "shell",
      "command": "pnpm --filter @nam/web exec playwright install",
      "detail": "One-time fetch of the chromium/firefox/webkit binaries used by the e2e suite",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Dev server",
      "type": "shell",
      "command": "pnpm dev",
      "detail": "Starts the Vite dev server (apps/web)",
      "isBackground": true,
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "pnpm build",
      "detail": "Typecheck + production build, via Turborepo",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "pnpm lint",
      "detail": "oxlint, via Turborepo",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Format check",
      "type": "shell",
      "command": "pnpm format:check",
      "detail": "Prettier --check, via Turborepo",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Format write",
      "type": "shell",
      "command": "pnpm format",
      "detail": "Prettier --write",
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test (watch)",
      "type": "shell",
      "command": "pnpm test",
      "detail": "Vitest in watch mode (apps/web)",
      "isBackground": true,
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Test (run once)",
      "type": "shell",
      "command": "pnpm test:run",
      "detail": "Vitest, single run - unit/component tests, via Turborepo",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test coverage",
      "type": "shell",
      "command": "pnpm --filter @nam/web test:coverage",
      "detail": "Vitest with the v8 coverage report (apps/web)",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "E2E test",
      "type": "shell",
      "command": "pnpm test:e2e",
      "detail": "Playwright e2e suite, via Turborepo - needs \"Install Playwright browsers\" run once first",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": [],
      "dependsOn": ["Install Playwright browsers"]
    },
    {
      "label": "Storybook",
      "type": "shell",
      "command": "pnpm storybook",
      "detail": "Starts the Storybook dev server (packages/ui)",
      "isBackground": true,
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Full check (lint + format + build + test + e2e)",
      "detail": "Everything CI runs, in order - see .github/workflows/ci.yml",
      "dependsOrder": "sequence",
      "dependsOn": ["Lint", "Format check", "Build", "Test (run once)", "E2E test"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "C++: Init submodules",
      "type": "shell",
      "command": "git submodule update --init --recursive -- packages/core/third_party/nam-core && git -C packages/core/third_party/dragonfly-reverb submodule update --init --depth 1 -- dpf",
      "detail": "One-time fetch of the vendored DSP library submodules (NAMCore's Eigen/AudioDSPTools, Dragonfly's dpf) - needed before configuring packages/core",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "C++: Configure",
      "type": "shell",
      "command": "cmake -S packages/core -B packages/core/build -DNAM_STUDIO_BUILD_TESTS=ON -DCMAKE_BUILD_TYPE=Debug",
      "detail": "Configures the packages/core C++ DSP library with tests enabled - see packages/core/README.md if cmake isn't on your PATH",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": [],
      "dependsOn": ["C++: Init submodules"]
    },
    {
      "label": "C++: Build",
      "type": "shell",
      "command": "cmake --build packages/core/build",
      "detail": "Builds packages/core (graph engine, NAM wrapper, Dragonfly Reverb algorithms)",
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": ["$gcc"],
      "dependsOn": ["C++: Configure"]
    },
    {
      "label": "C++: Test",
      "type": "shell",
      "command": "ctest --test-dir packages/core/build --output-on-failure",
      "detail": "Runs the packages/core CTest suite (graph engine, NAM inference, all 4 Dragonfly Reverb algorithms)",
      "group": { "kind": "test", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": [],
      "dependsOn": ["C++: Build"]
    }
  ]
}
