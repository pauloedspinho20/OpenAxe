{
  "name": "@openaxe/web",
  "private": true,
  "version": "0.2.2",
  "description": "OpenAxe web app — Vite + React + AudioWorklet + WASM",
  "repository": {
    "type": "git",
    "url": "https://github.com/pauloedspinho20/OpenAxe.git",
    "directory": "apps/web"
  },
  "homepage": "https://github.com/pauloedspinho20/OpenAxe#readme",
  "bugs": {
    "url": "https://github.com/pauloedspinho20/OpenAxe/issues"
  },
  "license": "GPL-3.0-only",
  "keywords": [
    "guitar",
    "amp-sim",
    "nam",
    "wasm",
    "audio"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --base=./",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format:check": "prettier --ignore-path ../../.prettierignore --check ."
  },
  "dependencies": {
    "@openaxe/ui": "workspace:*",
    "@types/p5": "^1.7.7",
    "p5": "^2.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.1",
    "oxlint": "^1.79.0",
    "playwright": "1.61.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
