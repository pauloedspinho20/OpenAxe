{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["es2015", "dom"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "paths": {
      "@openaxe/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src", "remotion.config.ts"],
  "exclude": ["dist", "node_modules"]
}
