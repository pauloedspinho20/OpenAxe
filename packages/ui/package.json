{
  "name": "@openaxe/ui",
  "version": "0.4.1",
  "private": true,
  "description": "OpenAxe shared design system — primitives, tokens, Wordmark",
  "repository": {
    "type": "git",
    "url": "https://github.com/pauloedspinho20/OpenAxe.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/pauloedspinho20/OpenAxe#readme",
  "bugs": {
    "url": "https://github.com/pauloedspinho20/OpenAxe/issues"
  },
  "license": "GPL-3.0-only",
  "keywords": [
    "design-system",
    "react",
    "tokens"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens/*": "./tokens/*",
    "./vanilla/*": "./vanilla/*"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "build": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@storybook/react": "^10.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
