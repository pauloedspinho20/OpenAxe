<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Generated by packages/vst3/CMakeLists.txt from this template — do not edit the
  copies under build/. Every substituted value comes from config.h or the root
  VERSION file so the bundle, the host's plugin manager and openAxe.version can
  never disagree (issue #300 E6/F3).

  What was wrong before: CMake's default plist was used, which set
  CFBundlePackageType to APPL (VST3 and AU both require BNDL) and left
  CFBundleIdentifier, CFBundleName and both version strings empty. REAPER is
  lenient enough to load that; auval refuses the AU outright, and an empty
  bundle identifier makes codesigning and notarization meaningless.
-->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>English</string>
  <key>CFBundleExecutable</key>
  <string>@OPENAXE_PLUG_NAME@</string>
  <key>CFBundleGetInfoString</key>
  <string>@OPENAXE_PLUG_NAME@ v@OPENAXE_VERSION@ @OPENAXE_COPYRIGHT@</string>
  <key>CFBundleIdentifier</key>
  <string>@OPENAXE_BUNDLE_ID@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>@OPENAXE_PLUG_NAME@</string>
  <key>CFBundlePackageType</key>
  <string>BNDL</string>
  <key>CFBundleShortVersionString</key>
  <string>@OPENAXE_VERSION@</string>
  <key>CFBundleSignature</key>
  <string>@OPENAXE_PLUG_UID@</string>
  <key>CFBundleVersion</key>
  <string>@OPENAXE_VERSION@</string>
  <key>CSResourcesFileMapped</key>
  <true/>
  <key>LSMinimumSystemVersion</key>
  <string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
@OPENAXE_PLIST_EXTRA@
</dict>
</plist>
